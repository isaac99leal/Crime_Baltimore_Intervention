{
  "pairing_rules": {
    "description": "Wine and food pairing rules based on classical sommelier training. Each rule maps food attributes to ideal wine attributes.",
    "principles": [
      "Match weight: light food with light wine, heavy food with full-bodied wine",
      "Acidity in wine cuts through fat and richness",
      "Tannin pairs with protein and fat, clashes with spice and fish",
      "Sweetness in wine should match or exceed sweetness in food",
      "Salt in food softens tannin and enhances fruit",
      "Umami makes wine seem more tannic and bitter — choose fruity, low-tannin wines",
      "Mirror or contrast: either echo flavors or create complementary contrast",
      "Regional pairings: what grows together goes together"
    ]
  },
  "flavor_bridges": {
    "description": "Aromatic compounds shared between food and wine that create harmonious pairings.",
    "bridges": {
      "linalool": {
        "found_in_wines": ["Muscat", "Gewürztraminer", "Riesling", "Torrontés"],
        "found_in_foods": ["coriander", "basil", "lavender", "citrus zest"],
        "effect": "Floral, aromatic bridge — creates a sense of harmony between herbal dishes and aromatic whites"
      },
      "rotundone": {
        "found_in_wines": ["Syrah", "Grüner Veltliner", "Mourvèdre"],
        "found_in_foods": ["black pepper", "rosemary", "thyme", "oregano"],
        "effect": "Peppery, spicy bridge — Syrah's natural pepperiness mirrors herb-crusted meats"
      },
      "methoxypyrazine": {
        "found_in_wines": ["Sauvignon Blanc", "Cabernet Franc", "Carmenère"],
        "found_in_foods": ["bell pepper", "green herbs", "asparagus", "peas"],
        "effect": "Green, herbaceous bridge — can be complementary or clash if too intense on both sides"
      },
      "sotolon": {
        "found_in_wines": ["Vin Jaune", "Sherry", "Tokaji", "aged Sauternes"],
        "found_in_foods": ["curry", "fenugreek", "maple syrup", "caramelized sugar"],
        "effect": "Nutty, caramel bridge — oxidative wines with caramelized or spiced dishes"
      },
      "thiols": {
        "found_in_wines": ["Sauvignon Blanc", "Colombard", "Verdejo"],
        "found_in_foods": ["grapefruit", "passion fruit", "blackcurrant leaf", "gooseberry"],
        "effect": "Tropical, citrus bridge — connects citrus-dressed seafood with aromatic whites"
      },
      "diacetyl": {
        "found_in_wines": ["oaked Chardonnay", "malolactic wines"],
        "found_in_foods": ["butter", "cream", "brioche", "croissant"],
        "effect": "Buttery bridge — MLF Chardonnay mirrors butter sauces perfectly"
      },
      "eugenol": {
        "found_in_wines": ["oak-aged reds", "Tempranillo", "Grenache"],
        "found_in_foods": ["clove", "allspice", "cinnamon", "vanilla"],
        "effect": "Spice bridge — oak-derived spice in wine mirrors warm baking spices in food"
      },
      "furaneol": {
        "found_in_wines": ["aged Pinot Noir", "Grenache", "Zinfandel"],
        "found_in_foods": ["strawberry", "caramel", "roasted meat", "balsamic"],
        "effect": "Sweet, caramel bridge — connects fruit-forward reds with caramelized or berry-based sauces"
      }
    }
  },
